#include <LiquidCrystal.h>

// LCD pins: RS=7, EN=6, D4=5, D5=4, D6=3, D7=2
LiquidCrystal lcd(7, 6, 5, 4, 3, 2);

// Sensors and LED
#define LED_PIN 8
#define TMP_PIN A0
#define LDR_PIN A1

// Thresholds
float tempThreshold = 30.0;  // Temperature in °C
int lightThreshold = 500;    // Light level (0-1023)

void setup() {
  Serial.begin(9600);
  pinMode(LED_PIN, OUTPUT);

  // Initialize LCD
  lcd.begin(16, 2);
  lcd.setCursor(0, 0);
  lcd.print("System Ready...");
  delay(1000);
  lcd.clear();
}

void loop() {
  // --- TMP36 Temperature ---
  int tempReading = analogRead(TMP_PIN);
  float voltage = tempReading * (5.0 / 1023.0);
  float temperatureC = (voltage - 0.5) * 100.0;

  // --- LDR Light ---
  int lightValue = analogRead(LDR_PIN);

  // --- LED Logic ---
  if (temperatureC > tempThreshold || lightValue < lightThreshold) {
    digitalWrite(LED_PIN, HIGH);  // ON
  } else {
    digitalWrite(LED_PIN, LOW);   // OFF
  }

  // --- Serial Monitor Output ---
  Serial.print("Temperature: ");
  Serial.print(temperatureC);
  Serial.print(" °C, Light: ");
  Serial.println(lightValue);

  // --- LCD Display ---
  lcd.setCursor(0, 0);
  lcd.print("Temp: ");
  lcd.print(temperatureC, 1);
  lcd.print((char)223);  // Degree symbol
  lcd.print("C   ");     // Spaces to clear old digits

  lcd.setCursor(0, 1);
  lcd.print("Light: ");
  lcd.print(lightValue);
  lcd.print("    ");     // Spaces to clear old digits

  delay(1000); // Update every second
}
